<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle outer hairline for contrast on bright wallpapers -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_corner_radius" />
            <stroke
                android:width="0.7dp"
                android:color="#2E000000" />
        </shape>
    </item>
    <!-- Soft curved glass inner dome bevel -->
    <item
        android:bottom="0.7dp"
        android:left="0.7dp"
        android:right="0.7dp"
        android:top="0.7dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_corner_radius" />
            <gradient
                android:angle="315"
                android:startColor="#30FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#1AFFFFFF" />
            <stroke
                android:width="1.4dp"
                android:color="#A8FFFFFF" />
        </shape>
    </item>
    <!-- Recessed inner curved-glass rim highlight -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_bevel_radius" />
            <stroke
                android:width="0.75dp"
                android:color="#2AFFFFFF" />
        </shape>
    </item>
</layer-list>
