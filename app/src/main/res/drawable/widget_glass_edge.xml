<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Whisper-thin contrast outline for bright wallpapers -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_corner_radius" />
            <stroke
                android:width="0.45dp"
                android:color="#1A000000" />
        </shape>
    </item>
    <!-- Exact Xiaomi HyperOS razor-thin translucent specular glass rim -->
    <item
        android:bottom="0.45dp"
        android:left="0.45dp"
        android:right="0.45dp"
        android:top="0.45dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_corner_radius" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1.15dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
