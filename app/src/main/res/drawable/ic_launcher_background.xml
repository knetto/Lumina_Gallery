<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Silky pearl-white luminous canvas (Samsung One UI 7 / Xiaomi HyperOS aesthetic) -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="12"
                android:endX="90"
                android:endY="96">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.62" android:color="#FFF7F9FF" />
                <item android:offset="1.0" android:color="#FFEBF1FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle warm ambient Lumina aura behind the prism blossom -->
    <path android:pathData="M18,54 A36,36 0 1,0 90,54 A36,36 0 1,0 18,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="36">
                <item android:offset="0.0" android:color="#80FFF7E0" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
