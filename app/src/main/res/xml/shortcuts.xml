<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_camera"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_camera"
        android:shortcutShortLabel="@string/shortcut_camera_short"
        android:shortcutLongLabel="@string/shortcut_camera_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.luminagallery.drive"
            android:targetClass="com.luminagallery.drive.MainActivity">
            <extra android:name="com.luminagallery.drive.EXTRA_SHORTCUT_TARGET" android:value="camera" />
        </intent>
    </shortcut>

