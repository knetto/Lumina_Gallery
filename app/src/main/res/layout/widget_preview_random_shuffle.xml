<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_glass_edge">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_photo_shuffle"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_art_aurora_pine" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:background="@drawable/widget_glass_button"
        android:contentDescription="@string/widget_next_photos"
        android:padding="6.5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_shuffle" />

</FrameLayout>
