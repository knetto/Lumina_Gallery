<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_glass_edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@drawable/widget_photo_divider"
        android:orientation="horizontal"
        android:showDividers="middle">

        <ImageView
            android:id="@+id/widget_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#273B55"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/widget_image_two"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#354E63"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/widget_image_three"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#244252"
            android:scaleType="centerCrop" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="12dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_open_gallery"
        android:textColor="#E7F0FF"
        android:textSize="12sp"
        android:visibility="gone" />

    <include layout="@layout/widget_next_photo" />

</FrameLayout>
