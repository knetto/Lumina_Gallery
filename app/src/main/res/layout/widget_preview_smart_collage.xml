<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_glass_edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FFFFFF"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="1.1dp"
            android:layout_weight="54"
            android:contentDescription="@string/widget_photo_collage"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_ocean_waves" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="46"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="1.1dp"
                android:layout_weight="52"
                android:contentDescription="@string/widget_photo_collage"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_sunset_peaks" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="48"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="1.1dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_photo_collage"
                    android:scaleType="centerCrop"
                    android:src="@drawable/widget_art_golden_meadow" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_photo_collage"
                    android:scaleType="centerCrop"
                    android:src="@drawable/widget_art_aurora_pine" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
