<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_glass_edge">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_favorites"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_art_ocean_waves" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="11dp"
        android:background="@drawable/widget_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/widget_favorites"
            android:src="@drawable/ic_widget_heart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_favorites"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
